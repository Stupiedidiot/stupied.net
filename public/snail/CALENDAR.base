filters:
  and:
    - '!file.folder.contains("_ignore")'
    - file.ext == "md"
    - or:
        - file.folder.startsWith("_art")
        - file.folder == "_posts"
        - file.folder.startsWith("_reviews/disney")
        - file.folder.startsWith("_commission")
formulas:
  thumbnail: |
    if(file.folder.startsWith('_posts'), image(thumbnail.replace('/blog/', '_img/blog/')), image(file.path.replace('.md','').replace(/^_([^\/]+)/,"_img/$1/img") + "." + ext))
  date: |-
    if (
        note.date,
        note.date,
        date(file.name.split('-').slice(0, 3).join('-'))
    )
  title: if(note.title, note.title, file.basename.replace('-',' '))
views:
  - type: calendar
    name: Calendar
    order:
      - formula.title
      - formula.thumbnail
    startDate: formula.date
    image: formula.thumbnail
    weekStartDay: sunday
