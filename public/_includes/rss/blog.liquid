{% assign replace = 'img src="' | append: site.url | append: '/blog/img/' %}
{% assign item = include.item %}
{% capture result %}
    {%- if item.thumbnail -%}
        <img src="{{ item.thumbnail | prepend: site.url }}"/>
    {%- else item.header -%}
        <img src="{{ item.header | prepend: site.url }}"/>
    {%- else item.before -%}
        {{ item.before }}
    {%- endif -%}
    {{ item.content | markdownify | replace: 'img src="img/', replace }}
{% endcapture %}
{{ result | escape }}