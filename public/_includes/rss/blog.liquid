{% assign replace = 'img src="' | append: site.url | append: '/blog/img/' %}
{% assign item = include.item %}
{% capture result %}
    {%- if item.thumbnail -%}
        <img src="{{ item.thumbnail | relative_url }}" alt="{{ item.alt }}"/>
    {%- else item.before -%}
        {{ item.before }}
    {%- endif -%}

    {{ item.content | markdownify | replace: 'img src="img/', replace }}
{% endcapture %}
{{ result | escape }}