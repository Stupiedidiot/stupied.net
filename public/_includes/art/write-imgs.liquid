{% assign data = include.data %}
{% assign collection = data.collection %}
{% assign dime_path = 'snail/_img/' | append: collection | append: '/img/' %}

{% assign path = data.path | getArtPath %}
{% assign collection = data.collection %}

{% assign img = path | append: '.' |  append: data.ext %}
{% capture path_full %}
    /{{ collection }}/img/{{ img }}
{% endcapture %}

{% assign dime = img | getDime: dime_path %}

{% capture img_el %}
    <img src="{{- path_full -}}" alt="{{ data.alt | escape }}" width="{{ dime[0] }}" height="{{ dime[1] }}" data-pagefind-meta="image[src]">
{% endcapture %}

{% if include.no_link %}
    {{ img_el }}
{% else %}
    <a href="{{- path_full -}}" id="{{ img | slugify }}" title="Open {{ data.title }}">
        {{ img_el }}
    </a>        
{% endif %}


{% unless include.no_extra %}
    {% for e in data.extra %}
        {% assign img = e.img | default: e %}
        {% capture path_full %}
            /{{ collection }}/img/{{ img }}
        {% endcapture %}
        
        {% assign dime = img | getDime: dime_path %}
        {% assign title = img | split: '/' | last | replace: '-', ' ' %}
        
        

        <a href="{{- path_full -}}" id="{{ img | slugify }}" title="Open {{ title }}">
            <img src="{{- path_full -}}" alt="{{ e.alt | escape }}" width="{{ dime[0] }}" height="{{ dime[1] }}" loading="lazy">
        </a>
    {% endfor %}
{% endunless %}