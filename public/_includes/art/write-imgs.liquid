{% assign data = include.data %}
{% assign collection = data.collection %}
{% assign dime_path = 'snail/_img/' | append: collection | append: '/img/' %}

{% capture img_el %}
    <img src="{{ data.thumbnail }}" alt="{{ data.alt | escape }}" width="{{ data.dime[0] }}" height="{{ data.dime[1] }}" data-pagefind-meta="image[src]">
{% endcapture %}

{% if include.no_link %}
    {{ img_el }}
{% else %}
    <a href="{{ data.thumbnail }}" id="{{ img | slugify }}" title="Open {{ data.title }}">
        {{ img_el }}
    </a>        
{% endif %}

{% unless include.no_extra %}
    {% for e in data.extra %}
        {% assign img = e.img | default: e %}
        {% capture extra_path %}
            /{{ collection }}/img/{{ img }}
        {% endcapture %}
        
        {% assign dime = img | getDime: dime_path %}
        {% assign title = img | split: '/' | last | replace: '-', ' ' %}
        
        <a href="{{- extra_path -}}" id="{{ img | slugify }}" title="Open {{ title }}">
            <img src="{{- extra_path -}}" alt="{{ e.alt | escape }}" width="{{ dime[0] }}" height="{{ dime[1] }}" loading="lazy">
        </a>
    {% endfor %}
{% endunless %}