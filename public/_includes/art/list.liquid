{% if include.data %}
    {% assign DATA = include.data %}
{% else %}
    {% assign DATA = site[include.col] | reverse %}
{% endif %}

{% assign DATA = DATA | where_exp: "item", "item.date <= site.time" %}

[
{%- for item in DATA -%}
    {% if item.dime[0] == 0 %}
        {% continue %}
    {% endif %}
    {
        "img": {{ item.img | jsonify }}

        {%- if item.date -%}
            ,"date": {{ item.date | default: '2007-08-04' | jsonify }}
        {%- endif -%}
        
        ,"title": {{ item.title | jsonify }}
        ,"dime": {{ item.dime | jsonify }}

        {%- if item.alt -%}
            ,"alt": {{ item.alt | escape | jsonify }}
        {%- endif -%}

        {%- if include.w_desc -%}
            {% if item.w_comment %}
                ,"desc": {{ item.content | markdownify | jsonify }}
            {% endif %}
        {%- endif -%}


        {%- if item.extra -%}
            ,"extra": [
                {%- for extra in item.extra -%}
                    {
                        "img": {{ extra.img | default: extra | jsonify }},
                        "alt": {{ extra.alt | escape | jsonify }}
                    }
                    {%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
            ]
        {%- endif -%}

        {%- if item.tags.size > 0 -%}
            ,"tags": {{ item.tags | join: ' ' | downcase | jsonify }}
        {%- endif -%}
    }
    {%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]