{% if include.data %}
    {% assign DATA = include.data %}
{% else %}
    {% assign DATA = site[include.col] | reverse %}
{% endif %}


{%- assign dir = 'snail/_img/' | append: include.col | append: '/img/' -%}
[
{%- for item in DATA -%}
    {%- assign img = item.path | getArtPath | append: '.' | append: item.ext-%}
    {
        "img": {{ img | jsonify }}

        {%- if item.date -%}
            ,"date": {{ item.date | default: '2007-08-04' | jsonify }}
        {%- endif -%}
        
        ,"title": {{ item.title | jsonify }}
        ,"dime": {{ img | writeDime: dir | jsonify }}

        {%- if item.alt -%}
            ,"alt": {{ item.alt | escape | jsonify }}
        {%- endif -%}

        {%- if include.w_desc -%}
            {% assign test = item.content | strip %}
            {% if test != "" %}
                ,"desc": {{ item.content | markdownify | jsonify }}
            {% endif %}
        {%- endif -%}


        {%- if item.extra -%}
            ,"extra": [
                {%- for extra in item.extra -%}
                    {
                        "img": {{ extra.img | default: extra | jsonify }},
                        "alt": {{ extra.alt | escape | jsonify }}
                    }
                    {%- unless forloop.last -%},{%- endunless -%}
                {%- endfor -%}
            ]
        {%- endif -%}

        {%- assign tags = item | getTags: true -%}
        {%- if tags.size > 0 -%}
            ,"tags": {{ tags | join: ' ' | downcase | jsonify }}
        {%- endif -%}
    }
    {%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]