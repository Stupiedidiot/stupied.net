{% if include.data %}
    {% assign DATA = include.data | getNxtPrv: page.path %}
    {% assign prev = DATA[1] %}
    {% assign next = DATA[2] %}
    <ul class="sub">
        {% if prev %}
            <li>
                <a id="nextprev_prev" href="{{ prev.url }}" title="View Previous Page">
                    <span class="icon-arrow-thin-left"></span>
                    <span>Prev</span>
                </a>
            </li>
        {% endif %}

        <li>
            <a href="{{ include.home | default: 'archive' }}">
                <span class="icon-inbox-full"></span>
                <span>Archive</span>
            </a>
        </li>

        {% if next %}
            <li>
                <a id="nextprev_next" href="{{ next.url }}" title="View Next Page">
                    <span>Next</span>
                    <span class="icon-arrow-thin-right"></span>
                </a>
            </li>
        {% endif %}
    </ul>
{% endif %}