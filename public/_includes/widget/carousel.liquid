{% assign DATA = site.art | concat: site.posts %}
{% assign ctr = 0 %}
{% for item in DATA %}
    {% if ctr >= 3 %}
        {% break %}
    {% endif %}

    {% unless item.extra or item.thumbnail %}
        {% continue %}
    {% else %}
        {% assign ctr = ctr | plus: 1 %}
    {% endunless %}
    <div id="{{ item.name }}" class="carousel slide">
        <a class="carousel-inner" onclick="console.log('WOW')">
            {% if item.collection == 'art' %}
                {% assign img = item.path | getArtPath | append: '.' | append: item.ext %}
                {% assign dime = img | getDime: 'snail/_img/art/img/' %}
                <div class="carousel-item active">
                    <img src="/art/img/{{ img }}" alt="{{ item.alt }}" width="{{ dime[0] }}" height="{{ dime[1] }}">
                </div>
            {% else %}
                <div class="carousel-item active">
                    <img src="{{ item.thumbnail }}" alt="{{ item.alt }}" width="{{ dime[0] }}" height="{{ dime[1] }}">
                </div>
            {% endif %}

            {% if item.extra %}
                {% for extra in item.extra %}
                    <div class="carousel-item">
                        <img src="/art/img/{{ extra.img | default: extra }}" alt="{{ extra.alt }}" width="{{ dime[0] }}" height="{{ dime[1] }}">
                    </div>
                {% endfor %}

                  <div class="carousel-indicators">
                    <button type="button" data-bs-target="#{{ item.name }}" data-bs-slide-to="0" class="active" aria-current="true" aria-label="Slide 1"></button>
                    {% for extra in item.extra %}
                        <button type="button" data-bs-target="#{{ item.name }}" data-bs-slide-to="{{ forloop.index }}" aria-label="Slide {{ forloop.index }}"></button>
                    {% endfor %}
                </div>
            {% endif %}
        </a>
        {% if item.extra %}
            <button class="carousel-control-prev" type="button" data-bs-target="#{{ item.name }}" data-bs-slide="prev">
                <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#{{ item.name }}" data-bs-slide="next">
                <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
        {% endif %}
    </div>
{% endfor %}