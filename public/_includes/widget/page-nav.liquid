{% if paginator.total_pages > 1 %}
    <ul class="sub">
        {% if paginator.next_page %}
            <li>
                <a id="nextprev-next" href="{{ paginator.next_page_path | prepend: site.baseurl }}" title="View Next Page">
                    <span class="icon-arrow-thin-left"></span>
                    <span>Next</span>
                </a>
            </li>
        {% endif %}

        {% if paginator.page_trail %}
            {% for trail in paginator.page_trail reverse %}
                {% if paginator.page == trail.num %}
                    {% continue %}
                {% endif %}
                <li class="white">
                    <a href="{{ trail.path | prepend: site.baseurl }}" title="{{trail.title}}"
                        {% if paginator.page == trail.num %}
                            class="nextprev-current"
                        {% endif %}
                    ><span>{{ trail.num }}</span></a>
                </li>
            {% endfor %}
        {% endif %}

        {% if paginator.previous_page %}
            <li>
                <a id="nextprev-prev" href="{{ paginator.previous_page_path | prepend: site.baseurl }}" title="View Previous Page">
                    <span>Prev</span>
                    <span class="icon-arrow-thin-right"></span>
                </a>
            </li>
        {% endif %}
    </ul>
{% endif %}