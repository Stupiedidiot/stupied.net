<script type="text/javascript" src="/meta/js/lightbox.js" defer></script>
<script type="text/javascript" src="/meta/js/toc.js" defer></script>

<header class="padded">
        
    <div class="border border-gray">
        <div id="blog_header" class="padded">
            {% if page.thumbnail %}
                <img src="{{ page.thumbnail }}" alt="{{ page.alt }}" id="blog_header_img" class="border ratio-1-1">
            {% endif %}
            <div id="blog_header_info">
                <h1>{{ page.title }}</h1>
                <time class="h4 clr-accent-dk" datetime="{{ page.date | date_to_xmlschema }}">
                    {{ page.date | date: "%B %-d, %Y" }}
                </time>
                {% if page.description %}
                    {{ page.description | markdownify }}
                {% endif %}
            </div>
        </div>

        <div class="toc-parent padded border-top border-gray border-dashed hidden">
            <details close>
                <summary>
                    <span class="h4">Table of Contents</span>
                </summary>
                <div id="blog_toc" class="toc-target"></div>
            </details>
        </div>
    </div>
</header>