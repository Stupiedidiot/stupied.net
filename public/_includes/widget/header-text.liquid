<script type="text/javascript" src="/meta/js/lightbox.js" defer></script>
<script type="text/javascript" src="/meta/js/toc.js" defer></script>

<header class="padded">
        
    <div class="border border-gray">
        <div class="post-feed-flex padded">
            <div class="post-feed-thumbnail">
                {% if page.thumbnail %}
                    <img src="{{ page.thumbnail }}" alt="{{ page.alt }}" class="border ratio-1-1">
                {% endif %}
            </div>
            <div class="post-feed-info">
                <h1>{{ page.title }}</h1>

                {{ include.content }}                
            </div>
        </div>

        <div class="toc-parent padded border-top border-gray border-dashed hidden">
            <details close>
                <summary>
                    <span class="h4">Table of Contents</span>
                </summary>
                <div id="blog_toc" class="toc-target"></div>
            </details>
        </div>
    </div>
</header>