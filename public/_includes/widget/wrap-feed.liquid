{% assign data = include.data | default: site.data.wrap %}
{% if data %}
    <div class="post-feed hover-color" data-nosnippet data-pagefind-ignore>
    {% assign limit = include.limit | default: site.data.wrap.size %}
    {% assign data = site.data.wrap | reverse %}

    {% for item in data limit:limit %}
        {%- capture link -%}
            href="{{ item.url }}" title="View {{ item.title }}"
        {%- endcapture -%}

        {% capture thumbnail %}
            <img src="{{ item.data.art[0].thumbnail }}" class="ratio-1-1 border" alt="{{ item.data.art[0].alt | escape }}" data-link="{{ item.url }}" loading="lazy" {{ " " }}
                {%- if item.dime -%} width="{{ item.dime[0] }}" height="{{ item.dime[1] }}"  {%- endif -%}
            >
        {% endcapture %}

        {% capture info %}
            <a {{ link }}>
                <div class="h2">
                    {{ item.title }}
                </div>

                {% include widget/wrap-summary.liquid item=item %}
            </a>
        {% endcapture %}

        {% include widget/box.liquid thumbnail=thumbnail info=info %}
    {% endfor %}
    </div>
{% endif %}