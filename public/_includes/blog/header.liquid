<script type="text/javascript" src="/meta/js/lightbox.js" defer></script>
<script type="text/javascript" src="/meta/js/toc.js" defer></script>

{%- capture thumbnail -%}
    {% if page.thumbnail %}
        <img src="{{ page.thumbnail }}" alt="{{ page.alt }}" class="border ratio-1-1">
    {% endif %}
{%- endcapture -%}

{%- capture info -%}
    <h1>{{ page.title }}</h1>
    <time class="h4 clr-accent-dk" datetime="{{ page.date | date_to_xmlschema }}">
        {{ page.date | date: "%B %-d, %Y" }}
    </time>
    {% if page.description %}
        {{ page.description | markdownify }}
    {% endif %}
{%- endcapture -%}

{%- capture after -%}
    <div class="padded border-top border-gray border-dashed toc-parent hidden">
        <details close>
            <summary>
                <span class="h4">Table of Contents</span>
            </summary>
            <div id="blog_toc" class="toc-target"></div>
        </details>
    </div>
{%- endcapture -%}

<header class="padded">
    {% include widget/box.liquid
        thumbnail = thumbnail 
        info = info
        after = after
    %}
</header>