<!-- The Side Bar -->

<aside aria-label="Sidebar" id="sidebar" class="offcanvas-lg offcanvas-start vh-100 overflow-y-auto position-md-sticky top-0 start-0">
  <div id="sidebar_content">

    <header id="sidebar_content"></header>

    <nav id="sidebar_nav" class="">
        <ul class="nav flex-column">
            {% for item in site.nav %}
                <li class="nav-item {% if item.link == page.url %}{{ " active" }}{% endif %} link-unstyled">
                    <a class="nav-link" href="{{ item.link }}">
                        <span class="icon-{{ item.icon }}"></span>
                        <span>{{ item.title }}</span>
                    </a>
                </li>
            {% endfor %}
        </ul>
    </nav>

  </div>
</aside>
<!-- #sidebar -->