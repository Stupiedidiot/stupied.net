{% for item in include.data %}
    <div class="character">
        <div class="character-info padded">
            <div class="character-thumbnail float-left">
                <img src="{{ item.thumbnail }}" alt="Thumbnail of {{ item.title }}">
            </div>

            <div class="h4">{{ item.title }}</div>
            
            <div>
                {{ item.description | markdownify }}
            </div>

            <hr class="clear">
        </div>

        <div class="post-feed-tags padded">
            <a href="{{ item.url }}" class="button"><span class="icon-information-outline"></span> Learn More</a>
            <a href="/art/archive?t={{ item.slug }}" class="button"><span class="icon-photo"></span> More Art »</a>
        </div>
    </div>
{% endfor %}