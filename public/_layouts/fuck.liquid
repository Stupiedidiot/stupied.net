---
layout: default
---
<nav class="navbar bg-body-tertiary d-lg-none border-bottom">
  <div class="container-xl">
    <a class="navbar-brand" href="#">
        <span>{{ site.title }}</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebar" aria-controls="sidebar">
      <span class="navbar-toggler-icon"></span>
    </button>
  </div>
</nav>


<div id="container" data-bs-theme="light" class="container-fluid p-0 border-end border-start">
    <div class="row g-0">
        <div id="sidebar_wrapper" class="col col-lg-2 col-12">
            {% include layout/sidebar.liquid %}
        </div>

        <div id="main_wrapper" class="col min-vh-100 border-start border-end">
            {% include layout/intro.liquid %}
            <main>
                {{ content }}
            </main>
        </div>
        
        <div id="aside_wrapper" class="col col-sm-4 col-md-3 col-12">
            {% include layout/aside.liquid %}
        </div>
    </div>
</div>

<div class="container-fluid bg-body-tertiary border-top">
    {% include layout/footer.liquid %}
</div>