---
layout: default
aside: true
---

{% include layout/nav.liquid %}

<div class="bg-second border-bottom">
    <div class="p-1">
        {% include splash.html %}
    </div>
</div>

<div id="container" class="container-fluid m-auto p-0">
    <div id="container_content" class="m-auto bg-first border-y">
        <div class="row g-0">
            <div id="main_wrapper" class="col min-vh-100 border-y">
                <main>
                    {% include layout/intro.liquid %}
                    {{ content }}
                </main>
            </div>

            {% if layout.aside %}
                <div id="aside_wrapper" class="bg-second col-sm-4 col-md-3 col-12">
                    {% include layout/aside.liquid %}
                </div>
            {% endif %}
        </div>
    </div>
    
    <footer class="m-0 bg-body border-top">
        {% include layout/footer.liquid %}
    </footer>
</div>