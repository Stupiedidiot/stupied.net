---
layout: default
aside: true
---

<div id="container">
    <!-- sidebar srt -->
        {% include_cached layout/sidebar.liquid %}
    <!-- sidebar end -->
    <div id="divider"></div>

    <div id="main">
        <main id="main_wrapper">
            <article class="padded">
                <h1>{{ page.title }}</h1>
                <blockquote>
                    <p>Blockquote</p>
                </blockquote>
                <p>Lorem ipsum dolor sit, amet consectetur adipisicing elit. Enim tempora accusantium nisi distinctio. Quidem sint praesentium quisquam mollitia, eum aut quaerat autem iure reprehenderit doloremque accusantium illum fugiat nam repudiandae?</p>

                <hr>

                <h2 class="clr-accent">Table of Contents</h2>
                <ul class="toc">
                    {% for item in site.posts %}
                        <li>
                            <a href="{{ item.url }}">
                                <span>{{ item.title }}</span>
                                <span class="dash"></span>
                                <span>{{ item.date | date: '%Y-%m-%-d' }}</span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
                
                <div class="card">
                    <div class="card-item"></div>
                </div>
            </article>
        </main>
        <!-- footer srt -->
            {% include_cached layout/footer.liquid %}
        <!-- footer end -->
    </div>
</div>