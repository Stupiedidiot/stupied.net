---
layout: blog
---

<main>
    {% include widget/header-text.liquid %}

    <article id="blog_content" class="content">
        {{ content }}
        <img src="img/sign-off.png" alt="Stupied was Here" class="sign-off">
    </article>
</main>

<nav class="border-x border-accent">
  {% assign HOME = '/blog/archive' %}
  {% assign DATA = site.posts | reverse %}
  {% include widget/nextprev.liquid data=DATA home=HOME %}
</nav>

<div id="blog_comments" class="padded">
  {% include widget/giscus.html category="Blog" %}
</div>