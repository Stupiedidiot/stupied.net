---
layout: blog
---

{% capture info %}
<time class="h4 clr-accent-dk" datetime="{{ page.date | date_to_xmlschema }}">
    {{ page.date | date: "%B %-d, %Y" }}
</time>
{% if page.description %}
    {{ page.description | markdownify }}
{% endif %}
{% endcapture %}

<main>
    {% include widget/header-text.liquid content=info%}

    <article id="blog_content" class="content">
        {{ content }}
        <hr class="clear">
    </article>
</main>

<nav class="border-x border-accent">
  {% assign HOME = '/blog/archive' %}
  {% assign DATA = site.posts | reverse %}
  {% include widget/nextprev.liquid data=DATA home=HOME %}
</nav>

<div id="blog_comments" class="padded">
  {% include widget/giscus.html category="Blog" %}
</div>

<div class="item-tags border-gray border-dashed-top padded">
    {%- for tag in page.tags -%}
        <a href="/blog/archive?t={{ tag }}" class="button">{{ tag }}</a>
    {%- endfor -%}
</div>