---
layout: blog
---

<main>
    {% include blog/header.liquid %}

    <article id="blog_content" class="content">
        {{ content }}
        <hr class="clear">
    </article>
</main>

<nav class="border-x border-accent">
  {% assign HOME = '/blog/archive' %}
  {% assign DATA = site.posts | reverse | getNxtPrv: page.path %}
  
  {% assign next = DATA[2] %}
  {% assign prev = DATA[1] %}
  {% include widget/nextprev.liquid next=next prev=prev home=HOME %}
</nav>

<div id="blog_comments" class="padded">
  {% include widget/giscus.html category="Blog" %}
</div>

<div class="item-tags border-gray border-dashed-top padded">
    {%- for tag in page.tags -%}
        <a href="/blog/archive?t={{ tag }}" class="button">{{ tag }}</a>
    {%- endfor -%}
</div>