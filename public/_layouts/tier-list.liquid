---
layout: none
---
<!DOCTYPE html>
<html lang="en-US">

<head>
  {% include head.html %}
  <link rel="stylesheet" href="/chez/reviews/main.css">
  <script src="/chez/reviews/main.js" defer></script>
</head>

<body>
  <div id="container">
    <header data-nosnippet>
      <h1>{{ page.title | default: "Tier List"}}</h1>
    </header>
    <main>
      {% if site.reviews %}
        {% assign REVIEWS = site.reviews | where_exp: "item", "item.path contains page.selected" | sort: "release" %}
        {%- assign TIERS = include.tiers | default: "S,A,B,C,D,E,F" | split: "," -%}
        
        <article class="tier_list">
          {%- for tier in TIERS -%}
            <section class="{{ tier }} tier">
                {%- assign selected = REVIEWS | where: "rank", tier -%}
                <div class="tier-label"><span>{{ tier }}</span></div>
                <div class="tier-items">
                {%- include chez/reviews/tier-item.html selected = selected -%}
                </div>
            </section>
          {%- endfor -%}
        </article>


        {%- assign REVIEWS = REVIEWS | where_exp: 'e', 'e.path contains "/f/"' | sort: "date" | reverse -%}

        {%- if REVIEWS.size > 0 -%}
        <article class="tier-feed">
            <h2>Recently Upload Reviews:</h2>
            <ul>
            {%- for item in REVIEWS limit:5 -%}
                {%- capture title -%}
                    {{ item.title | default: item.filename }}{% if item.release %} ({{ item.release }}){% endif %}
                {%- endcapture -%}
                <li>
                    <button onclick="viewer('{{ item.slug | downcase }}')" title="Reviewed on {{ item.date | date: '%Y/%m/%d' }}">{{ title }}</button>
                </li>
            {%- endfor -%}
            </ul>
        </article>
      {%- endif -%}

      {% endif %}

      {{ content }}
    </main>
  </div>

  <footer class="default-nav black padded">
    {%- include_cached footer.html -%}
  </footer>
</body>

</html>