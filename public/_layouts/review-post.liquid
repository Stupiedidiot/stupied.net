---
layout: review
---

<div id="review">
    <article id="{{ page.slug | downcase }}" class="padded">
        <fieldset>
            <legend>
                {%- if page.thumbnail -%}
                    <img src="{{ page.thumbnail }}" class="review-thumbnail" data-pagefind-meta="image[src]">
                {%- endif -%}
            </legend>

            <div>
                <h1>{{ page.title | split: '(' | first }}
                    {% if  page.release %}
                        (<span class="h2 clr-accent-dker">{{ page.release }}</span>)
                    {% endif %}
                </h1>
                {% assign rating = page.rank | append: ' Tier'  %}
                <span class="h3 clr-accent-dk">{{ page.quote | default: rating }}</span>

                {% if page.done %}
                    {{  page.content | markdownify }}
                    {% if page.link %}
                        <a href="{{ link }}" class="h6">
                            Watch Now »
                        </a>                    
                    {% endif %}

                    <hr class="clear">
                    <div style="text-align: right;">
                        <hr>
                        <time datetime="{{ page.date | date_to_xmlschema }}" class="h6">{{ page.date | date: "%B %-d, %Y" }}</time>
                    </div>
                {% else %}
                    <p>
                        Still writing my review...  
                    </p>
                {% endif %}
            </div>
        </fieldset>
    
        {% if page.link %}
            {% capture link %}
                <p><a href="{{ page.link }}" class="review-link">Watch Now!</a></p>
            {% endcapture %}
        {% endif %}
    
        
    </article>

    {% assign col = site.reviews %}
    {% assign info = col | where: 'done', 'true' | getNxtPrv: page.path %}
    {% assign index = info[0] %}
    {% assign prev = info[1] %}
    {% assign next = info[2] %}
    {% if prev or next %}
        <ul class="sub border-accent border-dashed-top">
            {% if prev %}
                <li>
                    <a id="nextprev_prev" href="{{ prev.url }}" title="View Previous Page">
                        <span class="icon-arrow-thin-left"></span>
                        <span>Prev</span>
                    </a>
                </li>
            {% endif %}
        
            {% if next %}
                <li>
                    <a id="nextprev_next" href="{{ next.url }}" title="View Next Page">
                        <span>Next</span>
                        <span class="icon-arrow-thin-right"></span>
                    </a>
                </li>
            {% endif %}
        </ul>
    {% endif %}
</div>