---
layout: page
---

<div id="review">
    {% assign col = site.reviews %}
    {% assign info = col | where: 'category', 'completed' | getNxtPrv: page.path %}
    {% assign index = info[0] %}
    {% assign prev = info[1] %}
    {% assign next = info[2] %}
    <ul class="sub">

        {% if prev %}
            <li>
                <a id="nextprev_prev" href="{{ prev.url }}" title="View Previous Page">
                    <span class="icon-arrow-thin-left"></span>
                    <span>Prev</span>
                </a>
            </li>
        {% endif %}
    
        <li>
            <a href="/chez/reviews/">
                <span class="icon-inbox-full"></span>
                <span>Archive</span>
            </a>
        </li>

        {% if next %}
            <li>
                <a id="nextprev_next" href="{{ next.url }}" title="View Next Page">
                    <span>Next</span>
                    <span class="icon-arrow-thin-right"></span>
                </a>
            </li>
        {% endif %}
    </ul>
    
    <article id="{{ page.slug | downcase }}" class="padded">
        {% assign thumbnail = page.name | split: '.' | first | downcase |  prepend: '/chez/reviews/img/' |  append: '.jpg' %}
        {% assign test = thumbnail |  prepend: '/snail/_img' | check_file %}
    
        {%- if test -%}
            <img src="{{ thumbnail }}" class="float-right review-thumbnail" data-pagefind-meta="image[src]">
        {%- endif -%}
    
        <h1>{{ page.title | split: '(' | first }}
            {% if  page.release %}
                (<span class="h2 clr-accent-lt">{{ page.release }}</span>)
            {% endif %}
        </h1>
    
        {% if page.link %}
            {% capture link %}
                <p><a href="{{ page.link }}" class="review-link">Watch Now!</a></p>
            {% endcapture %}
        {% endif %}
    
        <div>
            {% assign rating = page.rank | append: ' Tier'  %}
            <span class="h3 clr-accent">{{ page.quote | default: rating }}</span>

            {% if page.category == "completed" %}
                {{  page.content | markdownify }}
            {% endif %}

            {{ link }}

            <hr class="clear">
            <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: "%B %-d, %Y" }}</time>
        </div>
    </article>
</div>