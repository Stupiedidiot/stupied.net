---
layout: none
description: Archive of Stupied's Art
---
<!DOCTYPE html>
<html lang="en-US">

<head>
    {% include head.html %}
    <link rel="stylesheet" href="/art/main.css">
    <script src="/art/main.js" defer></script>
    
    {% if layout.view %}
        {% assign img = page.path | getArtPath | append: '.' |  append: page.ext %}
        {% assign dime = img | getDime: 'snail/_img/art/img/' %}
        <meta property="og:image" content="{{ img | append: site.url | append: '/art/img/'}}" />
        <meta property="og:image:height" content="{{ dime[1] }}" />
        <meta property="og:image:width" content="{{ dime[0] }}" />
        {% if page.alt %}
            <meta property="og:image:alt" content="{{ page.alt }}" />
        {% endif %}
    {% endif %}
    
    <meta data-pagefind-filter="category:art">
</head>

<body>
    {%- include_cached widget/sticky.html -%}
    <div id="container">
        <nav id="navMain" class="default-nav right" data-nosnippet>
            {%- include_cached nav.liquid data = site.data.nav.art -%}
        </nav>
        {% if page.include%}
            {% assign selected = page.include | default: layout.include %}
            {% include_relative _includes/{{selected}}.html %}
        {% elsif layout.view %}
            {% include art/viewer.liquid %}
        {% endif %}
        <div id="content">
            <main>
                {% if content contains 'justified-gallery' %}
                    {{ content | justifyImages: 'snail/_img/art/' }}
                {% else %}
                    {{ content}}
                {% endif %}
            </main>
            {% assign aside = page.name | prepend: '_includes/aside/' %}
            {% assign aside_check = aside | prepend: 'art/' | check_file %}
            {% if aside_check or layout.view %}
            <aside>
                <div id="aside-content">
                    {% if layout.view %}
                        {% include art/aside.liquid %}
                    {% else %}
                        {% include_relative {{ aside }} %} 
                    {% endif %}
                </div>
            </aside>
            {% endif %}
        </div>
        <footer data-nosnippet>
            <nav class="default-nav">
                {%- include_cached footer.html -%}
            </nav>
        </footer>
    </div>
</body>

</html>