---
layout: page
description: Archive of Stupied's Art
category: art

script:
- /art/main.js

nav:
  - title: Home
    icon: home
    link: /art/

  - title: Archive 
    icon: inbox-full
    link: /art/archive

  - title: Random
    icon: shuffle
    func: randomArt()
---

{% include_cached layout/subnav.liquid cat="art" %}

{% if page.include%}
  {% assign selected = page.include | default: layout.include %}
  {% include_relative _includes/{{selected}}.html %}
{% elsif layout.view %}
    <div id="art_viewer">
        <div id="image">
            {% assign path = page.path | getArtPath %}
            {% assign img = path | append: '.' |  append: page.ext %}
            {% assign dime = img | getDime: 'snail/_img/art/img/' %}
            <a href="/art/img/{{ img }}" title="Open {{ page.title }}">
                <img src="/art/img/{{ img }}" alt="{{ page.alt | escape }}" width="{{ dime[0] }}" height="{{ dime[1] }}" data-pagefind-meta="image[src]">
            </a>

            {% for e in page.extra %}
                {% assign img = e.img | default: e %}
                {% assign dime = img | getDime: 'snail/_img/art/img/' %}
                <a href="/art/img/{{ img }}" title="Open {{ e.img | split: '/' | last | replace: '-', ' ' }}">
                    <img src="/art/img/{{ img }}" alt="{{ e.alt | escape }}" width="{{ dime[0] }}" height="{{ dime[1] }}">
                </a>
            {% endfor %}
        </div>
    </div>

    {% assign col = site.art %}
    {% assign info = col | getArtNxtPrv: page.path %}
    {% assign index = info[0] %}

    <span id="art_index" hidden>{{ index }}</span>
    <ul id="art_nextprev"class="sub border-x">
        {% if page.next %}
            <li>
                <a href="{{ page.next.url }}" id="nextprev-next" title="Next Artwork: {{ page.next.title }}">
                    <span class="icon-arrow-thin-left"></span>
                    <span>Next</span>
                </a>
            </li>
        {% endif %}
        
        <li>
            <a href="/art/archive" id="nextprev-archive" title="View Art Archive"><span class="icon-inbox-full"></span> Archive</a>
        </li>
        
        {% if page.previous %}
            <li>
                <a href="{{ page.previous.url }}" id="nextprev-prev" title="Previous Artwork: {{ page.previous.title }}">
                    <span>Prev</span>
                    <span class="icon-arrow-thin-right"></span>
                </a>
            </li>
        {% endif %}
    </ul>
{% endif %}

<div id="art_container">
  <div id="art_main">
    {% if content contains 'justified-gallery' %}
        {{ content | justifyImages: 'snail/_img/art/' }}
    {% else %}
        {{ content}}
    {% endif %}
  </div>

  {% assign aside = page.name | prepend: '_includes/aside/' %}
  {% assign aside_check = aside | prepend: 'art/' | check_file %}

  {% if aside_check or layout.view %}
    <aside id="art_aside">
        <div id="art_aside_content">
            {% if layout.view %}
                <section id="aside-content" data-nosnippet>
                    <h2 class="h3">Related Artwork</h2>
                    <div id="art_related">
                        
                    </div>
                    <h3>Tags</h3>
                    <ul id="art_tags">
                        {% assign tags = page | getTags %}
                        {% for e in tags %}
                            <li><a href="/art/archive?t={{ e }}">{{ e }}</a></li>
                        {% endfor %}
                    </ul>
                </section>
            {% else %}
                {% include_relative {{ aside }} %} 
            {% endif %}
        </div>
    </aside>
  {% endif %}
</div>