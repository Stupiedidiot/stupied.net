---
layout: media
category: media
---

<div id="review">
    <article id="{{ page.slug | downcase }}" class="padded">
        <fieldset>
            <legend>
                {%- if page.thumbnail -%}
                    <img src="{{ page.thumbnail }}" class="review-thumbnail" data-pagefind-meta="image[src]">
                {%- endif -%}
            </legend>

            <div>
                <h1>{{ page.title }}
                    {% if  page.release %}
                        (<span class="h2 clr-accent-dker">{{ page.release }}</span>)
                    {% endif %}
                </h1>
                <span class="h3 clr-accent-dk">{{ page.rank | append: ' Tier' }}</span>

                {% if page.done %}
                    <div>
                        <hr>
                        <time datetime="{{ page.date | date_to_xmlschema }}" class="h6">{{ page.date | date: "%B %-d, %Y" }}</time>
                    </div>

                    {% if page.quote %}
                        <div class="blockquote">
                            {{ page.quote }}
                        </div>
                    {% endif %}

                    {{  page.content | markdownify }}
                    
                {% else %}
                    <p>
                        Still writing my review...  
                    </p>
                {% endif %}

                {% if page.link %}
                    <a href="{{ page.link }}" class="h6">
                        View Now »
                    </a>                    
                {% endif %}
            </div>

            {% if page.tags %}
                <hr>
                <div class="item-tags">
                    {%- for tag in page.tags -%}
                        <a href="/media/archive?t={{ tag }}" class="button">{{ tag }}</a>
                    {%- endfor -%}
                </div>    
            {% endif %}
        </fieldset>
    </article>

    {%- capture HOME -%}
        /{{ page.collection }}/archive
    {%- endcapture -%}
    {% include widget/nextprev.liquid prev=page.previous next=page.next home=HOME %}
</div>