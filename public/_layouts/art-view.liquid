---
layout: art
view: true
---
<article id="art_details" class="main-content">
  <div id="art_details_content">
    <h1 id="art_title">{{ page.title }}</h1>
    <div id="art_desc">
        <time datetime="{{ page.date | date_to_xmlschema }}">{{ page.date | date: "%B %-d, %Y" }}</time>
        {% assign test = content | strip %}
            {% if test != '' %}
            {{ content }}
        {% endif %}
    </div>
</div>
</article>

<article class="main-content">
  {% include widget/giscus.html category="Art" %}
</article>