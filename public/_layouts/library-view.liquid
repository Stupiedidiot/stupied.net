---
layout: library

nav:
  - title: Home
    icon: home
    link: "./"
    
  - title: Archive
    icon: inbox-full
    link: "./archive"

  - title: Library
    icon: inbox-full
    link: /lib/
        
---

<script src="/meta/js/comics.js" data-src="{{ page.json }}" defer></script>
{%- capture nextprev -%}
    <li>
      <a id="nextprev_prev" href="#" title="View Previous Comic">
          <span class="icon-arrow-thin-left"></span>
          <span>Prev</span>
      </a>
    </li>

    <li>
      <a id="nextprev_comment" href="#" title="Comment on comic">
          <span class="icon-chat"></span>    
          <span>Comment</span>
      </a>
    </li>

    <li>
      <a id="nextprev_next" href="#" title="View Next Comic">
          <span>Next</span>
          <span class="icon-arrow-thin-right"></span>
      </a>
    </li>
{%- endcapture -%}

{%- capture thumbnail -%}
    <img src="{{ page.thumbnail }}" alt="Thumbnail for {{ page.title }}" class="border ratio-1-1">
{%- endcapture -%}

{%- capture info -%}
    {% if page.description %}
        <h1>
            {{ page.title }}
        </h1>
        
        <div class="blockquote">
            {{ page.description | markdownify }}
        </div>

        {{ page.content | markdownify }}

        {% if page.external %}
            <p>
                <a href="{{ page.external }}">External Website »</a>
            </p>
        {% endif %}
    {% endif %}
{%- endcapture -%}

{%- capture toc -%}
<nav id="nextprev_archive" class="border-dashed-top border-gray padded hidden">
    <details close>
        <summary><span class="h6">Archive</span></summary>
        <div>
            <ul></ul>
        </div>
    </details>
</nav>
{%- endcapture -%}



<header class="padded">
    {% include widget/box.liquid
        thumbnail = thumbnail
        info = info
        after = toc 
    %}
</header>

<div class="padded border-top border-gray" style="margin-top: 1rem;">
    <h2 id="comic_title"></h2>
    {% comment %} insert comic date here. {% endcomment %}
</div>

<div id="comic" class="border-dashed-top border-gray"></div>

<div class="padded hidden border-dashed-top border-gray">
    <h3>Author's Notes</h3>
    <div id="comic_notes"></div>
</div>

<ul class="sub border-top border-accent">
  {{ nextprev }}
</ul>