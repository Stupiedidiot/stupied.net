---
layout: img-view-top
js:
  - /meta/js/img-view.js
---

<article id="art_details">
    <div id="art_details_content">
        <h1 id="art_title">
            <span>{{ page.title }}</span>    
        </h1>

        <div id="art_desc" class="padded">
            <time class="h4 clr-accent" datetime="{{ page.date | date_to_xmlschema }}">
                <span>{{ page.date | date: "%B %-d, %Y" }}</span>
            </time>

            {% if page.w_comment %}
                {{ content }}
            {% endif %}

            {% if site.comics and page.category %}
                {% assign comic = site.comics | where: "slug", page.category | first %}
                {% if comic %}
                    {%- capture thumbnail -%}
                        <img src="{{ comic.thumbnail }}" alt="Thumbnail for {{ comic.title }}" class="border ratio-1-1">
                    {%- endcapture -%}

                    {%- capture info -%}
                            <span class="h2">
                                {{ comic.title }}
                            </span>
                            {% if comic.description %}
                                {{ comic.description | markdownify }}
                            {% endif %}
                            <a href="{{ comic.url }}?p={{ page.img }}" class="h5 clr-accent-lt">More Comics »</a>
                    {%- endcapture -%}

                    {% include widget/box.liquid
                        thumbnail = thumbnail
                        info = info
                        after = toc 
                    %}
                {% endif %}
            {% endif %}

        </div>
    </div>
</article>

{% if site.data.ocs and page.tags contains "ocs" %}
    {% assign OCS = page.tags | get_ocs %}
    {% if OCS.size > 0 %}
        <div class="padded border-gray border-dashed-top">
            <fieldset data-nosnippet data-pagefind-ignore>
                <legend>
                    <h2>OCs Featured</h2>
                </legend>

                <div id="art_characters"
                    {%- if OCS.size > 1 -%}
                        {{  ' class="newspaper"' }}
                    {%- endif -%}
                >
                    {% include ocs.liquid data=OCS %}
                </div>
            </fieldset>
        </div>
    {% endif %}
{% endif %}

{% if page.collection == 'art' %}
    <div id="art_comment" class="padded border-gray border-dashed-top" data-nosnippet>
        {% include widget/giscus.html category="Art" %}
    </div>
{% endif %}