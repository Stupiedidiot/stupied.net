---
layout: page
js:
  - /meta/js/img-view.js
---

{% assign data = site.data.nav[page.collection] %}
{% include_cached layout/subnav.liquid data=data %}

<div id="art_viewer" style="--selected: url({{ page.thumbnail }})">
    <div id="image">
        {% include art/write-imgs.liquid data=page %}
    </div>
</div>

<nav id="art_nextprev" class="sub border-x">
    {% capture HOME %}
        /{{ page.collection }}/archive
    {% endcapture %}
    {% assign DATA = site[page.collection] | where_exp: "item", "item.date <= site.time" %}
    
    {% include widget/nextprev.liquid data=DATA home=HOME %}
</nav>

<div id="art_container" class="split">
  <div id="art_main">
    <article id="art_details">
            <div id="art_details_content">
                <h1 id="art_title">
                    <span>{{ page.title }}</span>    
                </h1>

                <div id="art_desc" class="padded">
                    <time class="h4 clr-accent" datetime="{{ page.date | date_to_xmlschema }}">
                        <span>{{ page.date | date: "%B %-d, %Y" }}</span>
                    </time>

                    {% if page.w_comment %}
                        {{ content }}
                    {% endif %}
                </div>
            </div>
        </article>

        {% if site.data.ocs and page.tags contains "ocs" %}
            {% assign OCS = page.tags | get_ocs %}
            {% if OCS.size > 0 %}
                <div class="padded border-dashed-top">
                    <fieldset data-nosnippet data-pagefind-ignore>
                        <legend>
                            <h2>OCs Featured</h2>
                        </legend>

                        <div id="art_characters"
                            {%- if OCS.size > 1 -%}
                                {{  ' class="newspaper"' }}
                            {%- endif -%}
                        >
                            {% include ocs.liquid data=OCS %}
                        </div>
                    </fieldset>
                </div>
            {% endif %}
        {% endif %}

        {% if page.collection == 'art' %}
            <article id="art_comment" class="padded border-dashed-top" data-nosnippet>
                {% include widget/giscus.html category="Art" %}
            </article>
        {% endif %}
  </div>

    <aside id="art_aside" class="split-aside">
        <div id="art_aside_content" class="split-aside-content">
            <section id="aside-content" data-nosnippet>

                {% assign index = site[page.collection] | where_exp: "item", "item.date <= site.time" | getNxtPrv: page.path | first %}
                <h2 class="h3">Related Artwork</h2>
                <div id="art_related" data-col="{{ page.collection }}" data-idx="{{ index }}">
                    
                </div>
                <h3>Tags</h3>
                <ul id="art_tags">
                    {% for tag in page.tags %}
                        <li><a href="/{{ page.collection }}/archive?t={{ tag }}">{{ tag }}</a></li>
                    {% endfor %}
                </ul>

            </section>
        </div>
    </aside>
</div>