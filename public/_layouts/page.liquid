---
layout: default

# nav:
#   - title: Info
#     icon: information-outline
#     link: /art/

#   - title: Archive 
#     icon: inbox-full
#     link: /art/archive
  
#   - title: Random
#     icon: shuffle
#     func: randomArt()

#   - title: Usage
#     icon: news-paper
#     link: /about/art#usage
---
{%- include_cached widget/sticky.html -%}
<div id="container" class="default {{ page.class | default: layout.class }}">
    
    {% unless page.no_nav %}
        <div>
            <div id="nav_root" class="ribbon" data-nosnippet>
                <nav class="default-nav">
                    {%- include_cached nav.liquid data = site.nav -%}
                </nav>
            </div>
            
            {% if layout.nav %}
                <div id="nav_sub" data-nosnippet>
                    <nav class="default-nav">
                        {%- include_cached nav.liquid data = layout.nav -%}
                    </nav>
                </div>
            {% endif %}
        </div>
    {% endunless %}

    <div id="container_content">
        {{ content }}
    </div>

    <footer id="nav_foot" class="ribbon" data-nosnippet>
        <nav class="default-nav">
            {%- include_cached footer.html -%}
        </nav>
    </footer>
</div>