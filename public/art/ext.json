---
layout: none
---
{% assign DATA = site.art | reverse %}
[
    {%- assign dir = 'snail/_img/art/img/' -%}
    {%- for item in DATA -%}
        {
            "img": {{ item.img | jsonify }},
            "dimension": {{ item.dime | jsonify }}
        }

        {%- if item.extra -%}
            {%- for extra in item.extra -%}
            ,{
                {% assign extra_img = extra.img | default: extra %}
                "img": {{ extra_img | jsonify }},
                "dimension": {{ extra_img | getDime: dir | jsonify }}
            }
            {%- endfor -%}
        {%- endif -%}

        {%- unless forloop.last -%},{%- endunless -%}

    {%- endfor -%}

]