---
layout: none
---
{% assign DATA = site.art | reverse %}
[
    {%- assign dir = 'snail/_img/art/img/' -%}
    {%- for item in DATA -%}
        {
            "img": {{ item.thumbnail | jsonify }},
            "dimension": {{ item.dime | jsonify }}
        }

        {%- if item.extra -%}
            {%- for i in item.extra -%}
            ,{
                {% assign extra = i.img | default: i %}
                "img": {{ extra | jsonify }},
                "dimension": {{ extra | jsonify }}
            }
            {%- endfor -%}
        {%- endif -%}

        {%- unless forloop.last -%},{%- endunless -%}

    {%- endfor -%}

]