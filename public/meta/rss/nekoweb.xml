---
layout: rss
link: https://stupied.nekoweb.org
---
{% assign max = 500 %}
{% assign FEED = site.art | concat: site.posts | where_exp: "item", "item.date <= site.time" | sort: 'date' | reverse %}
{%- for item in FEED limit: 100 -%}
<item>
    <title>{{ item.title | escape }}</title>
    <pubDate>{{ item.date | date: "%a, %d %b %Y %T" | append: " PST"}}</pubDate>
    
    <link>{{ item.url | prepend: site.url }}</link>

    <guid isPermaLink="false">{{ item.collection }}-{{ item.date | date: "%Y-%m-%dT%H-%M" }}</guid>

    <description>
        {% if item.collection == 'art' %}
            {% assign test = item.content | strip %}
            {%- if test != '' -%}
                {{ item.content | strip_html | truncate: max, '...Read More' }}
            {% else %}
                Added Art
            {%- endif -%}
        {% else %}
            {{ item.description | default: item.desc | default: "Blog Post" | strip_html | truncate: max, '...Read More' }}
        {% endif %}
    </description>
</item>
{%- endfor -%}